# ========================================================
# NEOFOOD — CONFIGURACIÓN DE PRODUCCIÓN (.env)
# ========================================================

# 1. URL del Backend de NeoFood en Producción
VITE_API_URL=https://api.tu-restaurante.com/api/v1

# 2. Identidad por defecto del Restaurante
VITE_BRAND_NAME="NeoFood"
VITE_BRAND_SLUG="neofood"

# 3. Paleta de Colores Oficial (Índigo & Esmeralda)
VITE_BRAND_THEME_PRESET="landing"
VITE_BRAND_PRIMARY="#4f46e5"
VITE_BRAND_SECONDARY="#10b981"

# 4. Modo de Enrutamiento de Dominio:
# - "auto" (Recomendado):
#     * En el dominio principal del cliente -> Muestra la Tienda Virtual
#     * En el subdominio administrativo (panel.tu-restaurante.com) -> Muestra Login / Dashboard
#     * En localhost o dominio comercial -> Muestra la Landing Page
# - "store": Fuerza siempre la Tienda Virtual en "/"
# - "panel": Fuerza siempre el Login / Dashboard en "/"
VITE_APP_MODE="auto"
VITE_PANEL_SUBDOMAIN_PREFIX="panel"
