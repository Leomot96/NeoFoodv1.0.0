# ========================================================
# CONFIGURACIÓN DEL SERVIDOR NEOFOOD (PRODUCCIÓN)
# ========================================================
PORT=4000
NODE_ENV=production

# Seguridad JWT (Generar claves seguras y robustas en producción)
JWT_SECRET=neofood_jwt_secret_production_change_this_key_2026_xyz
JWT_EXPIRES_IN=15m

# Seguridad Refresh Token
JWT_REFRESH_SECRET=neofood_refresh_jwt_secret_production_change_this_key_2026_xyz
JWT_REFRESH_EXPIRES_IN=7d

# Base de datos MySQL / Prisma
# Formato: mysql://usuario:contraseña@servidor:puerto/nombre_base_datos
DATABASE_URL="mysql://root:password@localhost:3306/neofood_db"

# Orígenes Permitidos (CORS) - Configura tu dominio real de producción
FRONTEND_URL="https://tu-restaurante.com"
CORS_ORIGINS="https://tu-restaurante.com,https://pedidos.tu-restaurante.com"

# Identidad y Marca Oficial NeoFood (Landing Índigo & Verde Esmeralda)
BRAND_NAME="NeoFood"
BRAND_SLUG="neofood"
BRAND_PRIMARY_COLOR="#4f46e5"
BRAND_SECONDARY_COLOR="#10b981"
BRAND_THEME_PRESET="landing"

# Envío de Correos Transaccionales (Resend - Opcional)
RESEND_API_KEY=""
EMAIL_FROM="NeoFood <notificaciones@tu-dominio.com>"
