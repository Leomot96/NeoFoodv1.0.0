generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ==========================================
// 0. RESTAURANTE / ESTABLECIMIENTO
// ==========================================

model Restaurant {
  id                 String   @id @default(uuid())
  name               String   @default("NeoFood")
  slug               String   @unique @default("neofood")
  document           String?  // NIT o Cédula fiscal
  email              String?  // Correo oficial del establecimiento
  phone              String?  // Teléfono comercial
  address            String?  // Dirección comercial
  logoUrl            String?  // URL o ruta al logotipo
  bannerUrl          String?  @db.MediumText // Banner o cabecera de la tienda virtual
  bannerPosition     String?  @default("center") // Posición visual del banner
  storeSchedule      String?  @db.Text // Días y horario de atención de la tienda
  storeDescription   String?  @db.Text // Lema o descripción comercial
  storeAnnouncement  String?  @db.Text // Anuncio / promoción destacada en la tienda
  isStoreActive      Boolean  @default(true) // Tienda virtual activa para pedidos
  whatsappNumber     String?  // WhatsApp oficial para pedidos

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("restaurant")
}

// ==========================================
// 1. USUARIOS, ROLES Y CLIENTES
// ==========================================

model Role {
  id          String   @id @default(uuid())
  name        String   @unique // Ej: Administrador, Cajero, Mesero, Supervisor
  description String?
  isActive    Boolean  @default(true)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("roles")
}

model User {
  id              String              @id @default(uuid())
  email           String              @unique
  password        String
  name            String
  phone           String?
  refreshToken    String?             @db.Text
  roleId          String
  role            Role                @relation(fields: [roleId], references: [id])
  isActive        Boolean             @default(true)
  orders          Order[]
  cashSessions    CashSession[]
  cashAudits      CashAudit[]         @relation("AuditorRelation")
  cashAuditsOwned CashAudit[]         @relation("CashierRelation")
  auditLogs       AuditLog[]
  inventoryMoves  InventoryMovement[]
  expenses        Expense[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@map("users")
}

model Customer {
  id        String           @id @default(uuid())
  document  String?          @unique
  name      String
  email     String?
  phone     String?
  address   String?

  balance   Decimal          @default(0) @db.Decimal(10, 2) // Saldo total que debe (Deuda)
  credits   CustomerCredit[]

  orders    Order[]
  sales     Sale[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("customers")
}

model CustomerCredit {
  id              String         @id @default(uuid())
  customerId      String
  customer        Customer       @relation(fields: [customerId], references: [id])
  
  type            CreditType     // DEBT (Deuda por venta) o PAYMENT (Abono)
  amount          Decimal        @db.Decimal(10, 2)
  description     String         // Ej: "Factura #123" o "Abono en Efectivo"
  
  saleId          String?        // Si es una deuda, la ligamos a la factura original
  sale            Sale?          @relation(fields: [saleId], references: [id])
  
  paymentMethodId String?        // Si es un abono, indicamos cómo pagó (Efectivo, Nequi)
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])

  cashSessionId   String?
  cashSession     CashSession?   @relation(fields: [cashSessionId], references: [id])

  createdAt       DateTime       @default(now())

  @@index([customerId])
  @@map("customer_credits")
}

enum CreditType {
  DEBT
  PAYMENT
}

// ==========================================
// 2. CATÁLOGO, PRODUCTOS Y RECETAS
// ==========================================

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

model Product {
  id              String                  @id @default(uuid())
  name            String
  description     String?                 @db.Text
  price           Decimal                 @db.Decimal(10, 2)
  imageUrl        String?                 @db.MediumText
  categoryId      String
  category        Category                @relation(fields: [categoryId], references: [id])
  isAvailable     Boolean                 @default(true)
  showInStore     Boolean                 @default(true) // Mostrar en la tienda virtual pública
  trackStock      Boolean                 @default(false)
  isCombo         Boolean                 @default(false)
  stock           Decimal?                @default(0) @db.Decimal(14, 4)
  ingredients     ProductIngredient[]
  orderDetails    OrderDetail[]
  saleDetails     SaleDetail[]
  modifiers       ProductModifier[]
  additions       ProductAddition[]
  linkedInOptions ProductModifierOption[] @relation("LinkedProductOptions")
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@map("products")
}

model Ingredient {
  id                        String                     @id @default(uuid())
  name                      String
  unit                      String
  currentStock              Decimal                    @default(0) @db.Decimal(14, 4)
  minStock                  Decimal                    @default(0) @db.Decimal(14, 4)
  costPerUnit               Decimal                    @default(0) @db.Decimal(14, 4)
  
  averageCost               Decimal                    @default(0) @db.Decimal(14, 4)
  lastCost                  Decimal                    @default(0) @db.Decimal(14, 4)
  unitPurchase              String?                    
  purchaseFactor            Decimal?                   @db.Decimal(14, 4)
  isManufactured            Boolean                    @default(false)
  isActive                  Boolean                    @default(true)

  products                  ProductIngredient[]
  purchaseDetail            PurchaseDetail[]
  inventoryMoves            InventoryMovement[]
  productAdditions          ProductAddition[]
  modifierOptions           ProductModifierOption[]
  modifierOptionIngredients ModifierOptionIngredient[]
  
  recipeIngredients         IngredientRecipe[]         @relation("RecipeOutput")
  usedInRecipes             IngredientRecipe[]         @relation("RecipeIngredient")
  productionOrders          ProductionOrder[]
  productionConsumptions    ProductionConsumption[]
  
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt

  @@map("ingredients")
}

model ProductIngredient {
  id           String     @id @default(uuid())
  productId    String
  ingredientId String
  quantity     Decimal    @db.Decimal(14, 4)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([productId, ingredientId])
  @@map("product_ingredients")
}

model ProductModifier {
  id           String                  @id @default(uuid())
  productId    String
  product      Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  name         String                  
  isRequired   Boolean                 @default(true) 
  options      ProductModifierOption[]
  
  @@map("product_modifiers")
}

model ProductModifierOption {
  id           String                  @id @default(uuid())
  modifierId   String
  modifier     ProductModifier         @relation(fields: [modifierId], references: [id], onDelete: Cascade)
  saleDetails  SaleDetailVariation[]
  
  name         String          
  priceExtra   Decimal                 @default(0) @db.Decimal(10, 2) 

  // Descuento de inventario directo (ej: Pan, Plátano)
  ingredientId String?
  ingredient   Ingredient?             @relation(fields: [ingredientId], references: [id])
  quantity     Decimal?                @db.Decimal(14, 4)

  // Múltiples insumos para opciones compuestas (ej: Picada -> Papas + Plátano)
  ingredients  ModifierOptionIngredient[]

  // Si la opción en un combo representa un producto específico
  linkedProductId String?
  linkedProduct   Product?             @relation("LinkedProductOptions", fields: [linkedProductId], references: [id])
  
  @@map("product_modifier_options")
}

model ModifierOptionIngredient {
  id           String                @id @default(uuid())
  optionId     String
  option       ProductModifierOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  ingredientId String
  ingredient   Ingredient            @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  quantity     Decimal               @db.Decimal(14, 4)

  @@map("modifier_option_ingredients")
}

model ProductAddition {
  id           String      @id @default(uuid())
  productId    String
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  name         String      
  price        Decimal     @db.Decimal(10, 2)
  
  saleDetails  SaleDetailAddition[]

  // Si la adición gasta inventario (Ej: Carne extra)
  ingredientId String?     
  ingredient   Ingredient? @relation(fields: [ingredientId], references: [id])
  quantity     Decimal?    @db.Decimal(14, 4)

  @@map("product_additions")
}

// ==========================================
// 3. PROVEEDORES Y COMPRAS
// ==========================================

model Supplier {
  id        String     @id @default(uuid())
  nit       String?    @unique
  name      String
  phone     String?
  email     String?
  address   String?
  purchases Purchase[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@map("suppliers")
}

model Purchase {
  id            String           @id @default(uuid())
  supplierId    String
  supplier      Supplier         @relation(fields: [supplierId], references: [id])
  invoiceNumber String?
  totalCost     Decimal          @db.Decimal(10, 2)
  status        PurchaseStatus   @default(COMPLETED)
  details       PurchaseDetail[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@map("purchases")
}

model PurchaseDetail {
  id           String     @id @default(uuid())
  purchaseId   String
  ingredientId String
  quantity     Decimal    @db.Decimal(14, 4)
  unitCost     Decimal    @db.Decimal(14, 4)
  totalCost    Decimal    @db.Decimal(14, 4)
  purchase     Purchase   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@map("purchase_details")
}

enum PurchaseStatus {
  PENDING
  COMPLETED
  CANCELLED
}

// ==========================================
// 4. INVENTARIO (MOVIMIENTOS)
// ==========================================

model InventoryMovement {
  id           String       @id @default(uuid())
  ingredientId String
  ingredient   Ingredient   @relation(fields: [ingredientId], references: [id])
  userId       String
  user         User         @relation(fields: [userId], references: [id])
  type         MovementType
  quantity     Decimal      @db.Decimal(14, 4)
  reason       String?
  createdAt    DateTime     @default(now())

  @@index([createdAt])
  @@index([ingredientId])
  @@map("inventory_movements")
}

enum MovementType {
  IN
  OUT
  ADJUSTMENT
}

// ==========================================
// 5. OPERACIÓN: MESAS Y PEDIDOS
// ==========================================

model Table {
  id        String   @id @default(uuid())
  name      String   @unique
  capacity  Int?
  isActive  Boolean  @default(true)
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tables")
}

model Order {
  id                   String        @id @default(uuid())
  orderNumber          Int           @default(autoincrement()) @unique
  userId               String?
  user                 User?         @relation(fields: [userId], references: [id])
  customerId           String?
  customer             Customer?     @relation(fields: [customerId], references: [id])
  tableId              String?
  table                Table?        @relation(fields: [tableId], references: [id])
  status               OrderStatus   @default(PENDING)
  orderType            OrderType     @default(DINE_IN)
  notes                String?
  totalAmount          Decimal       @default(0) @db.Decimal(10, 2)

  // Campos para Pedidos de la Tienda Virtual
  isOnlineStore        Boolean       @default(false)
  customerName         String?
  customerPhone        String?
  customerEmail        String?
  deliveryAddress      String?       @db.Text
  deliveryNeighborhood String?
  paymentMethodName    String?

  details              OrderDetail[]
  sale                 Sale?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([createdAt])
  @@index([status])
  @@index([userId])
  @@map("orders")
}

model OrderDetail {
  id        String   @id @default(uuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2)
  subtotal  Decimal  @db.Decimal(10, 2)
  notes     String?
  modifiers Json?
  additions Json?
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("order_details")
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  DELIVERED
  CANCELLED
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

// ==========================================
// 6. VENTAS Y FACTURACIÓN
// ==========================================

model PaymentMethod {
  id              String           @id @default(uuid())
  name            String           @unique
  isActive        Boolean          @default(true)
  sales           Sale[]
  customerCredits CustomerCredit[]
  payments        SalePayment[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("payment_methods")
}

model Sale {
  id              String             @id @default(uuid())
  invoiceNumber   String?            @unique
  orderId         String             @unique
  order           Order              @relation(fields: [orderId], references: [id])
  customerId      String?
  customer        Customer?          @relation(fields: [customerId], references: [id])
  paymentMethodId String
  paymentMethod   PaymentMethod      @relation(fields: [paymentMethodId], references: [id])
  cashSessionId   String
  cashSession     CashSession        @relation(fields: [cashSessionId], references: [id])
  totalAmount     Decimal            @db.Decimal(10, 2)
  discount        Decimal            @default(0) @db.Decimal(10, 2)
  finalAmount     Decimal            @db.Decimal(10, 2)
  details         SaleDetail[]
  payments        SalePayment[]
  customerCredits CustomerCredit[]

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([createdAt])
  @@index([cashSessionId])
  @@index([paymentMethodId])
  @@map("sales")
}

model SalePayment {
  id              String        @id @default(uuid())
  saleId          String
  sale            Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  paymentMethodId String
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id])
  amount          Decimal       @db.Decimal(10, 2)
  notes           String?
  createdAt       DateTime      @default(now())

  @@index([saleId])
  @@index([paymentMethodId])
  @@map("sale_payments")
}

model SaleDetail {
  id                   String                @id @default(uuid())
  saleId               String
  productId            String
  quantity             Int
  unitPrice            Decimal               @db.Decimal(10, 2)
  subtotal             Decimal               @db.Decimal(10, 2)
  unitCost             Decimal?              @db.Decimal(14, 4) // Costo histórico unitario
  totalCost            Decimal?              @db.Decimal(14, 4) // Costo histórico total
  notes                String?
  sale                 Sale                  @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product              Product               @relation(fields: [productId], references: [id])
  saleDetailAdditions  SaleDetailAddition[]
  saleDetailVariations SaleDetailVariation[]

  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@map("sale_details")
}

model SaleDetailAddition {
  id           String           @id @default(uuid())
  saleDetailId String
  additionId   String?
  name         String?
  quantity     Int              @default(1)
  price        Decimal          @db.Decimal(10, 2)

  saleDetail   SaleDetail       @relation(fields: [saleDetailId], references: [id], onDelete: Cascade)
  addition     ProductAddition? @relation(fields: [additionId], references: [id], onDelete: SetNull)

  @@map("sale_detail_additions")
}

model SaleDetailVariation {
  id           String                 @id @default(uuid())
  saleDetailId String
  variationId  String?
  name         String?
  price        Decimal                @db.Decimal(10, 2)

  saleDetail   SaleDetail             @relation(fields: [saleDetailId], references: [id], onDelete: Cascade)
  variation    ProductModifierOption? @relation(fields: [variationId], references: [id], onDelete: SetNull)

  @@map("sale_detail_variations")
}

// ==========================================
// 7. CAJA Y FINANZAS
// ==========================================

model CashSession {
  id              String           @id @default(uuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id])
  openingAmount   Decimal          @db.Decimal(10, 2)
  closingAmount   Decimal?         @db.Decimal(10, 2)
  status          SessionStatus    @default(OPEN)
  openedAt        DateTime         @default(now())
  closedAt        DateTime?
  sales           Sale[]
  cashMovements   CashMovement[]
  cashAudit       CashAudit?
  expenses        Expense[]
  customerCredits CustomerCredit[]
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([openedAt])
  @@index([status])
  @@map("cash_sessions")
}

model CashMovement {
  id            String       @id @default(uuid())
  cashSessionId String
  cashSession   CashSession  @relation(fields: [cashSessionId], references: [id])
  type          MovementType
  amount        Decimal      @db.Decimal(10, 2)
  description   String
  createdAt     DateTime     @default(now())

  @@map("cash_movements")
}

model CashAudit {
  id              String      @id @default(uuid())
  cashSessionId   String      @unique
  cashSession     CashSession @relation(fields: [cashSessionId], references: [id])
  auditorId       String
  auditor         User        @relation("AuditorRelation", fields: [auditorId], references: [id])
  cashierId       String
  cashier         User        @relation("CashierRelation", fields: [cashierId], references: [id])
  expectedAmount  Decimal     @db.Decimal(10, 2)
  actualAmount    Decimal     @db.Decimal(10, 2)
  difference      Decimal     @db.Decimal(10, 2)
  notes           String?
  createdAt       DateTime    @default(now())

  @@map("cash_audits")
}

model Expense {
  id            String       @id @default(uuid())
  userId        String
  user          User         @relation(fields: [userId], references: [id])
  cashSessionId String?
  cashSession   CashSession? @relation(fields: [cashSessionId], references: [id])
  amount        Decimal      @db.Decimal(10, 2)
  category      String
  description   String
  date          DateTime     @default(now())
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@map("expenses")
}

enum SessionStatus {
  OPEN
  CLOSED
}

// ==========================================
// 8. SISTEMA Y AUDITORÍA
// ==========================================

model Configuration {
  id            String   @id @default(uuid())
  key           String   @unique
  value         String   @db.Text
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("configurations")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   String?  @db.Text
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}

// ==========================================
// 9. PRODUCCIÓN Y RECETAS DE INVENTARIO
// ==========================================

model IngredientRecipe {
  id                  String     @id @default(uuid())
  outputIngredientId  String
  inputIngredientId   String
  quantity            Decimal    @db.Decimal(14, 4)
  unit                String?    // Unidad en la que se consume
  
  outputIngredient    Ingredient @relation("RecipeOutput", fields: [outputIngredientId], references: [id], onDelete: Cascade)
  inputIngredient     Ingredient @relation("RecipeIngredient", fields: [inputIngredientId], references: [id], onDelete: Cascade)
  
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@unique([outputIngredientId, inputIngredientId])
  @@map("ingredient_recipes")
}

model ProductionOrder {
  id                  String     @id @default(uuid())
  ingredientId        String     // El ingrediente elaborado que se produce
  ingredient          Ingredient @relation(fields: [ingredientId], references: [id])
  quantityProduced    Decimal    @db.Decimal(14, 4)
  totalCost           Decimal    @db.Decimal(14, 4)
  unitCost            Decimal    @db.Decimal(14, 4)
  status              ProductionStatus @default(PENDING)
  consumptions        ProductionConsumption[]
  
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@map("production_orders")
}

model ProductionConsumption {
  id                  String     @id @default(uuid())
  productionOrderId   String
  ingredientId        String
  quantity            Decimal    @db.Decimal(14, 4)
  unitCost            Decimal    @db.Decimal(14, 4)
  totalCost           Decimal    @db.Decimal(14, 4)
  
  productionOrder     ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  ingredient          Ingredient      @relation(fields: [ingredientId], references: [id])

  @@map("production_consumptions")
}

enum ProductionStatus {
  PENDING
  COMPLETED
  CANCELLED
}
